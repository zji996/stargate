[Unit]
Description=Stargate private frp relay over AnyTLS
After=network.target stargate-remote-controller.service
Requires=stargate-remote-controller.service

[Service]
User=stargate-remote
Group=stargate-remote
ExecStart=/usr/local/lib/stargate-remote/frps -c /etc/stargate-remote/frps.json
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
UMask=0077

[Install]
WantedBy=multi-user.target
