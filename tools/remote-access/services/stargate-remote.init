#!/bin/sh /etc/rc.common
START=96
STOP=19
USE_PROCD=1

remote_dir=/etc/stargate-remote
remote_bin=/usr/bin/stargate-remote

start_service() {
  [ -f "$remote_dir/profile.json" ] || return 0
  /usr/bin/sing-box check -c "$remote_dir/transport.json" || return 1
  /usr/bin/frpc verify -c "$remote_dir/frpc.json" || return 1
  procd_open_instance transport
  procd_set_param command /usr/bin/sing-box run -c "$remote_dir/transport.json"
  procd_set_param respawn 3600 5 5
  procd_set_param stdout 1
  procd_set_param stderr 1
  procd_set_param limits nofile="65536 65536"
  procd_close_instance
  procd_open_instance frpc
  procd_set_param command /usr/bin/frpc -c "$remote_dir/frpc.json"
  procd_set_param respawn 3600 5 5
  procd_set_param stdout 1
  procd_set_param stderr 1
  procd_close_instance
  procd_open_instance sync
  procd_set_param command "$remote_bin" watch --dir "$remote_dir"
  procd_set_param respawn 3600 5 5
  procd_set_param stdout 1
  procd_set_param stderr 1
  procd_close_instance
}

reload_service() {
  "$remote_bin" sync --dir "$remote_dir"
}
