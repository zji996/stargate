# S20M/S20L nftables build fragment for HWRT/OpenWrt full buildroot.
#
# Use this as a config fragment, then run:
#   make defconfig
#
# Do not use these kmod packages from a different build. OpenWrt kernel
# modules must match the exact kernel ABI of the image they run on.

CONFIG_TARGET_mediatek=y
CONFIG_TARGET_mediatek_filogic=y
CONFIG_TARGET_mediatek_filogic_DEVICE_chuliuxiang_s20m=y
CONFIG_TARGET_PER_DEVICE_ROOTFS=y

# Replace fw3 with fw4.
# CONFIG_PACKAGE_firewall is not set
CONFIG_PACKAGE_firewall4=y

# nftables userspace used by firewall4.
CONFIG_PACKAGE_nftables-json=y
CONFIG_PACKAGE_libnftnl=y
CONFIG_PACKAGE_ucode=y
CONFIG_PACKAGE_ucode-mod-fs=y
CONFIG_PACKAGE_ucode-mod-ubus=y
CONFIG_PACKAGE_ucode-mod-uci=y

# Kernel nftables support required by firewall4.
CONFIG_PACKAGE_kmod-nft-core=y
CONFIG_PACKAGE_kmod-nft-fib=y
CONFIG_PACKAGE_kmod-nft-nat=y
CONFIG_PACKAGE_kmod-nft-offload=y

# Useful for transparent proxy and future tproxy mode.
CONFIG_PACKAGE_kmod-nft-socket=y
CONFIG_PACKAGE_kmod-nft-tproxy=y

# Optional iptables compatibility through nft backend.
# Keep this for the first migration image so old diagnostics and packages
# can still run while the system firewall is fw4.
CONFIG_PACKAGE_iptables-nft=y
CONFIG_PACKAGE_ip6tables-nft=y

# dnsmasq nftset support. Stargate does not require DHCP/DNS takeover by
# default, but this avoids rebuilding again if nftset integration is needed.
# CONFIG_PACKAGE_dnsmasq is not set
CONFIG_PACKAGE_dnsmasq-full=y
