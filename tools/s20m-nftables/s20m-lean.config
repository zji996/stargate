# Keep the S20M nftables migration image focused on a single sysupgrade
# target. This avoids building unrelated RAM-boot artifacts, PHY crypto
# firmware, and broad wireless firmware bundles from the mt798x buildroot.

# CONFIG_TARGET_MULTI_PROFILE is not set
# CONFIG_TARGET_ALL_PROFILES is not set
# CONFIG_ALL_KMODS is not set
# CONFIG_ALL_NONSHARED is not set

# No wireless firmware stack is needed on this S20M deployment.
# CONFIG_PACKAGE_linux-firmware is not set
# CONFIG_PACKAGE_kmod-mt7915-firmware is not set
# CONFIG_PACKAGE_mt7915-firmware is not set
# CONFIG_PACKAGE_mt7986-wo-firmware is not set

# Do not build optional MediaTek RAM-boot/bootloader artifacts for this
# sysupgrade-only image. The router keeps its existing U-Boot/BL2/FIP.
# CONFIG_PACKAGE_trusted-firmware-a-mt7981-ram-ddr3 is not set
# CONFIG_PACKAGE_trusted-firmware-a-mt7981-ram-ddr4 is not set
# CONFIG_PACKAGE_trusted-firmware-a-mt7986-ram-ddr3 is not set
# CONFIG_PACKAGE_trusted-firmware-a-mt7986-ram-ddr4 is not set
# CONFIG_PACKAGE_trusted-firmware-a-mt7987-ram-comb is not set
# CONFIG_PACKAGE_trusted-firmware-a-mt7988-ram-comb is not set
# CONFIG_PACKAGE_trusted-firmware-a-mt7988-ram-ddr3 is not set
# CONFIG_PACKAGE_trusted-firmware-a-mt7988-ram-ddr4 is not set

# Optional PHY/crypto modules and firmware not required by the captured
# S20M/S20L DTS. They otherwise pull linux-firmware into the full build.
# CONFIG_DEFAULT_kmod-crypto-hw-safexcel is not set
# CONFIG_PACKAGE_kmod-crypto-hw-safexcel is not set
# CONFIG_PACKAGE_kmod-phy-airoha-en8811h is not set
# CONFIG_PACKAGE_airoha-en8811h-firmware is not set
# CONFIG_PACKAGE_eip197-mini-firmware is not set

# Avoid removable-storage helpers unless they are explicitly needed later.
# CONFIG_PACKAGE_automount is not set
# CONFIG_PACKAGE_block-mount is not set
# CONFIG_PACKAGE_f2fsck is not set
# CONFIG_PACKAGE_mkf2fs is not set
