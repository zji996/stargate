#!/bin/sh /etc/rc.common

# The dedup front; see /usr/share/stargate/dedup.sh. Nothing runs while
# stargate.dedup.enabled is 0.
START=94
STOP=21
USE_PROCD=1

cgroup_root="/sys/fs/cgroup"

# procd runs each instance in a child of services/stargate-dedup, so a limit
# there also covers an old front still draining; past it the kernel kills a
# front, not sing-box.
limit_memory() {
  grep -qw memory "$cgroup_root/cgroup.controllers" 2>/dev/null || {
    echo "stargate-dedup: no memory cgroup, only the fronts' soft limits apply" >&2
    return 0
  }
  for dir in "$cgroup_root" "$cgroup_root/services"; do
    mkdir -p "$dir"
    grep -qw memory "$dir/cgroup.subtree_control" ||
      echo +memory >"$dir/cgroup.subtree_control" || return 0
  done
  mkdir -p "$cgroup_root/services/stargate-dedup"
  echo "$1" >"$cgroup_root/services/stargate-dedup/memory.max"
}

start_service() {
  front="$(/usr/share/stargate/dedup.sh front)" || return 1
  [ -n "$front" ] || return 0
  limit_memory "$(uci -q get stargate.dedup.memory_mib || echo 300)M"
  procd_open_instance "${front%% *}"
  # shellcheck disable=SC2086
  procd_set_param command /usr/bin/stargate-dedup ${front#* }
  procd_set_param respawn 3600 1 0
  procd_set_param term_timeout 35
  procd_set_param stdout 1
  procd_set_param stderr 1
  procd_close_instance
}
