#!/bin/sh /etc/rc.common

START=95
STOP=20
USE_PROCD=1

name="stargate"
command="/usr/bin/sing-box"
config="/etc/stargate/config.json"
app_enabled="0"
node_server=""
node_password=""

load_uci() {
  config_load stargate
  config_get app_enabled global enabled "0"
  config_get command global singbox_bin "/usr/bin/sing-box"
  config_get config global config_file "/etc/stargate/config.json"
  config_get node_server node server ""
  config_get node_password node password ""
}

stop_service() {
  /usr/share/stargate/stargate.sh firewall-clean >/dev/null 2>&1 || true
}

service_triggers() {
  procd_add_reload_trigger stargate
}

start_service() {
  load_uci
  [ "$app_enabled" = "1" ] || {
    /usr/share/stargate/stargate.sh firewall-clean >/dev/null 2>&1 || true
    echo "Stargate disabled in UCI"
    return 0
  }
  [ -n "$node_server" ] && [ -n "$node_password" ] || {
    echo "active node missing: add a node and use it before starting Stargate" >&2
    return 1
  }
  [ -x "$command" ] || {
    echo "sing-box missing: $command" >&2
    return 1
  }
  if [ "${STARGATE_CONFIG_READY:-0}" != "1" ]; then
    /usr/share/stargate/stargate.sh apply || return 1
  fi
  [ -f "$config" ] || {
    echo "config missing: $config" >&2
    return 1
  }
  "$command" check -c "$config" || return 1
  procd_open_instance
  procd_set_param command "$command" run -c "$config"
  procd_set_param respawn 3600 5 5
  procd_set_param stdout 1
  procd_set_param stderr 1
  procd_close_instance
  /usr/share/stargate/stargate.sh firewall-apply-rules >/dev/null || {
    rc=$?
    echo "failed to apply Stargate firewall rules" >&2
    /usr/share/stargate/stargate.sh firewall-clean >/dev/null 2>&1 || true
    return "$rc"
  }
}

reload_service() {
  /usr/share/stargate/stargate.sh apply-runtime
}
