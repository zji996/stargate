{
  "luci-app-stargate": {
    "description": "Grant access to Stargate",
    "read": {
      "uci": [ "stargate" ],
      "ubus": {
        "file": [ "read", "stat" ]
      },
      "file": {
        "/etc/stargate/config.json": [ "read" ],
        "/etc/stargate/config.json.next": [ "read" ],
        "/usr/share/stargate/rules/direct.json": [ "read", "stat" ],
        "/usr/share/stargate/rules/proxy.json": [ "read", "stat" ],
        "/usr/share/stargate/rules/geoip-cn.srs": [ "read", "stat" ],
        "/usr/share/stargate/rules/geoip-google.srs": [ "read", "stat" ],
        "/usr/share/stargate/rules/geoip-facebook.srs": [ "read", "stat" ],
        "/usr/share/stargate/rules/geoip-twitter.srs": [ "read", "stat" ],
        "/usr/share/stargate/rules/geoip-telegram.srs": [ "read", "stat" ]
      }
    },
    "write": {
      "uci": [ "stargate" ],
      "ubus": {
        "file": [ "exec", "write" ],
        "uci": [ "add", "apply", "confirm", "delete", "set", "commit" ]
      },
      "file": {
        "/etc/stargate/config.json": [ "write" ],
        "/etc/stargate/config.json.next": [ "write" ],
        "/usr/share/stargate/rules/direct.json": [ "write" ],
        "/usr/share/stargate/rules/proxy.json": [ "write" ],
        "/usr/share/stargate/rules/geoip-cn.srs": [ "write" ],
        "/usr/share/stargate/rules/geoip-google.srs": [ "write" ],
        "/usr/share/stargate/rules/geoip-facebook.srs": [ "write" ],
        "/usr/share/stargate/rules/geoip-twitter.srs": [ "write" ],
        "/usr/share/stargate/rules/geoip-telegram.srs": [ "write" ],
        "/usr/share/stargate/stargate.sh": [ "exec" ],
        "/etc/init.d/stargate": [ "exec" ],
        "/tmp/stargate-restore-upload.tar.gz": [ "write" ],
        "/tmp/stargate-sing-box-upload": [ "write" ],
        "/tmp/stargate-sing-box.new": [ "write" ],
        "/tmp/stargate-backup-*.tar.gz": [ "read", "write" ],
        "/tmp/stargate-before-reset-*.tar.gz": [ "write" ],
        "/tmp/stargate-*.tar.gz": [ "read", "write" ]
      }
    }
  }
}
