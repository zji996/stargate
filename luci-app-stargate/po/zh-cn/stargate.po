msgid "Build the next sing-box config from UCI. It only writes the staging file and does not start the service."
msgstr "从 UCI 生成下一份 sing-box 配置，只写入待校验文件，不启动服务。"

msgid "Run sing-box check against the staging config before it becomes active."
msgstr "对待校验配置运行 sing-box check，确认通过后再作为正式配置使用。"

msgid "Validate and replace the active config. It does not enable transparent proxy or change firewall rules."
msgstr "校验并替换当前正式配置，不启用透明代理，也不改防火墙规则。"

msgid "Restart only the Stargate sing-box service with the current active config."
msgstr "仅使用当前正式配置重启 Stargate 的 sing-box 服务。"

msgid "Restore the last backup config created before Apply. If Stargate is running, it restarts with the restored config."
msgstr "恢复上一次应用前备份的配置。如果 Stargate 正在运行，会用恢复后的配置重启。"

msgid "Back up or restore Stargate client, rules, and generated sing-box configuration."
msgstr "备份或还原 Stargate 客户端、规则和已生成的 sing-box 配置。"

msgid "Note: restoring config across very different versions may cause compatibility issues."
msgstr "注意：不同版本间的配置恢复可能会导致兼容性问题。"

msgid "Create backup file"
msgstr "创建备份文件"

msgid "Download backup"
msgstr "下载备份"

msgid "Exports Stargate UCI config, generated config, backup config, env, and local rule files."
msgstr "导出 Stargate UCI 配置、已生成配置、回滚备份、env 和本地规则文件。"

msgid "Restore backup file"
msgstr "恢复备份文件"

msgid "Restore backup"
msgstr "恢复备份"

msgid "Restore a backup created by Stargate. The current UCI config is kept as /etc/config/stargate.restore_from."
msgstr "恢复 Stargate 创建的备份。当前 UCI 配置会保留为 /etc/config/stargate.restore_from。"

msgid "Restore default config"
msgstr "恢复默认配置"

msgid "Reset"
msgstr "执行重置"

msgid "Reset Stargate config to defaults and stop the service?"
msgstr "将 Stargate 配置恢复默认并停止服务？"

msgid "Reset only Stargate's own UCI config. It does not touch PassWall2, OpenClash, DHCP, dnsmasq, or firewall rules."
msgstr "只重置 Stargate 自己的 UCI 配置，不触碰 PassWall2、OpenClash、DHCP、dnsmasq 或防火墙规则。"

msgid "Rollback generated config"
msgstr "回滚生成配置"

msgid "Restore the last generated config backup created before Apply. If Stargate is running, it restarts with the restored config."
msgstr "恢复上一次应用前备份的生成配置。如果 Stargate 正在运行，会用恢复后的配置重启。"

msgid "Choose a backup file first."
msgstr "请先选择备份文件。"

msgid "Blocked until an active node is configured on the Node page."
msgstr "需要先在节点页配置当前节点后才能执行。"

