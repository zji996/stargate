msgstr "请输入域名或 IP。"

msgid "Test policy"
msgstr "测试策略"

msgid "Rules updated successfully."
msgstr "规则已更新成功。"

msgid "Rule update started. Refresh status in a moment."
msgstr "规则更新已开始，稍后刷新状态查看结果。"

msgid "Rule status refreshed."
msgstr "规则状态已刷新。"

msgid "Private IP direct"
msgstr "私有 IP 直连"

msgid "Block QUIC"
msgstr "阻断 QUIC"

msgid "Reject UDP/443 so browsers and apps fall back from HTTP/3/QUIC to TCP/TLS. This can make proxy routing more predictable, but may reduce speed for services that benefit from QUIC."
msgstr "拒绝 UDP/443，让浏览器和应用从 HTTP/3/QUIC 回退到 TCP/TLS。这样代理分流更可预测，但可能降低依赖 QUIC 的服务速度。"

msgid "Transparent proxy"
msgstr "透明代理"

msgid "Transparent mode"
msgstr "透明模式"

msgid "Transparent port"
msgstr "透明代理端口"

msgid "Startup mode"
msgstr "启动方式"

msgid "Start local proxy"
msgstr "启动本机代理"

msgid "Start transparent proxy"
msgstr "启动透明代理"

msgid "Stop"
msgstr "停止"

msgid "Local proxy keeps only SOCKS/HTTP. Transparent proxy adds a sing-box transparent inbound; redirect is the default."
msgstr "本机代理只启动 SOCKS/HTTP。透明代理会额外启动 sing-box 透明入站，默认 redirect。"

msgid "Recent Stargate and sing-box logs."
msgstr "最近的 Stargate 和 sing-box 日志。"

