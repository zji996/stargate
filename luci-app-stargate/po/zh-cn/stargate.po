msgstr "规则策略"

msgid "Blacklist mode"
msgstr "黑名单模式"

msgid "Whitelist mode"
msgstr "白名单模式"

msgid "Blacklist: default direct, listed proxy domains use the node. Whitelist: default proxy, listed direct domains go direct."
msgstr "黑名单：默认直连，代理列表域名走节点。白名单：默认代理，直连列表域名走直连。"

msgid "Rule source"
msgstr "规则来源"

